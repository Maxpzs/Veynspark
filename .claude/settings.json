{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(flutter pub *)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter doctor*)",
      "Bash(flutter clean*)",
      "Bash(flutter build *)",
      "Bash(dart format *)",
      "Bash(dart fix *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git checkout -b *)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(./android/key.properties)",
      "Read(./ios/**/*.p12)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dart format lib test >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
